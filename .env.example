DATABASE_PATH=data/app.db
# Optional outside Streamlit. In Streamlit, the Supabase connection secret
# automatically selects PostgreSQL. Use `sqlite` explicitly for legacy/local runs.
# DATABASE_BACKEND=postgres
# SUPABASE_DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
MAX_POSTGRES_POOL_SIZE=8
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
OPENALEX_API_KEY=replace-with-openalex-api-key

# Resource protection. Defaults shown here are suitable for a small deployment.
RATE_LIMIT_DATABASE_PATH=data/security_limits.db
MAX_AI_PROMPT_CHARS=120000
AI_REQUESTS_PER_USER_HOUR=30
AI_REQUESTS_PER_USER_DAY=100
AI_GLOBAL_REQUESTS_PER_MINUTE=60
AI_GLOBAL_REQUESTS_PER_DAY=1000
AI_MAX_CONCURRENT_REQUESTS=8
AI_MAX_OUTPUT_TOKENS=4096
OPENALEX_MAX_QUERIES_PER_SEARCH=5
OPENALEX_MAX_QUERY_CHARS=300
OPENALEX_REQUESTS_PER_USER_HOUR=120
OPENALEX_REQUESTS_PER_USER_DAY=500
OPENALEX_GLOBAL_REQUESTS_PER_MINUTE=120
OPENALEX_GLOBAL_REQUESTS_PER_DAY=5000
OPENALEX_MAX_CONCURRENT_REQUESTS=8
MAX_LIBRARY_FILES_PER_UPLOAD=10
MAX_LIBRARY_UPLOAD_BATCH_BYTES=104857600
MAX_LIBRARY_STORAGE_BYTES=524288000
MAX_LIBRARY_STORED_FILES=2000
MAX_ANALYSIS_FILE_SIZE=26214400
MAX_ANALYSIS_ROWS=100000
MAX_ANALYSIS_COLUMNS=250
MAX_ANALYSIS_ENCODED_FEATURES=500
MAX_ANALYSIS_STORAGE_BYTES=262144000
MAX_STORED_ANALYSIS_FILES=1000
ANALYSIS_RUNS_PER_USER_HOUR=20
ANALYSIS_RUNS_PER_USER_DAY=100
ANALYSIS_GLOBAL_RUNS_PER_MINUTE=15
ANALYSIS_GLOBAL_RUNS_PER_DAY=1000
ANALYSIS_MAX_CONCURRENT_RUNS=2
ANALYSIS_MAX_LEASE_SECONDS=600
MAX_AUDIO_FILE_SIZE=26214400
MAX_AUDIO_DURATION_SECONDS=600
MAX_AUDIO_STORAGE_BYTES=262144000
MAX_STORED_AUDIO_FILES=500
TRANSCRIPTIONS_PER_USER_HOUR=12
TRANSCRIPTIONS_PER_USER_DAY=50
TRANSCRIPTIONS_GLOBAL_PER_DAY=200
MAX_CONCURRENT_TRANSCRIPTIONS=1
MAX_FIGURE_PIXELS=50000000
MAX_NORMALIZED_FIGURE_SIZE=52428800
MAX_MANUSCRIPT_ASSET_STORAGE_BYTES=262144000
MAX_STORED_MANUSCRIPT_FIGURES=500
MAX_USER_DATABASE_BYTES=262144000
MIN_FREE_DISK_BYTES=1073741824

# Optional migration settings. Copy the owner's `user_id` (`sub`) and Auth0
# domain (`iss`) from Auth0 Dashboard to keep using the pre-authentication data.
# AUTH0_LEGACY_OWNER_SUB=auth0|replace-with-user-id
# AUTH0_LEGACY_OWNER_ISSUER=https://YOUR_AUTH0_DOMAIN/
