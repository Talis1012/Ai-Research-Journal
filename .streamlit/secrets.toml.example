[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-openssl-rand-hex-32"
expose_tokens = "id"

[auth.auth0]
client_id = "replace-with-auth0-client-id"
client_secret = "replace-with-auth0-client-secret"
server_metadata_url = "https://YOUR_AUTH0_DOMAIN/.well-known/openid-configuration"
client_kwargs = { prompt = "login" }

[supabase]
url = "https://YOUR_PROJECT_REF.supabase.co"
publishable_key = "replace-with-supabase-publishable-key"

[connections.supabase_postgres]
url = "postgresql+psycopg://APP_USER:APP_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require"
